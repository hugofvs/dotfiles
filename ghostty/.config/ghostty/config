theme = Catppuccin Mocha
font-family = JetBrainsMono Nerd Font
font-size = 13
adjust-cell-height = 20%

# Find Nushell on PATH; it loads ~/.config/nushell/{config,env}.nu by default.
command = nu
confirm-close-surface = true

keybind = ctrl+shift+l=inspector:toggle
keybind = ctrl+shift+t=toggle_command_palette

# Cmd+A leader (Super+A on Linux). Ghostty sequences have no timeout.
keybind = super+a>left=goto_split:left
keybind = super+a>h=goto_split:left
keybind = super+a>right=goto_split:right
keybind = super+a>l=goto_split:right
keybind = super+a>up=goto_split:up
keybind = super+a>k=goto_split:up
keybind = super+a>down=goto_split:down
keybind = super+a>j=goto_split:down

# Ghostty resizes in pixels rather than terminal cells.
keybind = super+a>shift+h=resize_split:left,30
keybind = super+a>shift+l=resize_split:right,30
keybind = super+a>shift+k=resize_split:up,30
keybind = super+a>shift+j=resize_split:down,30

keybind = super+a>backslash=new_split:right
keybind = super+a>minus=new_split:down
keybind = super+a>c=new_tab
keybind = super+a>q=close_surface
